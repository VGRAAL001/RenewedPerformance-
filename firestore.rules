rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'arendsberucia@gmail.com';
    }

    match /users/{userId} {
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    match /bookings/{bookingId} {
      allow create: if (request.auth != null
        && request.resource.data.userId == request.auth.uid)
        || (request.auth == null
          && request.resource.data.userId == null
          && request.resource.data.customerName is string
          && request.resource.data.customerEmail is string
          && request.resource.data.customerPhone is string);
      allow read, update: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    match /classes/{classId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['booked', 'updatedAt'])
          && request.resource.data.booked == resource.data.booked + 1
          && request.resource.data.booked <= resource.data.capacity
        );
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mail/{mailId} {
      allow create: if isAdmin();
      allow read, update, delete: if false;
    }

    match /oneOnOneSlots/{slotId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.status == 'reserved';
      allow update, delete: if isAdmin();
    }
  }
}