rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'arendsberucia@gmail.com';
    }

    match /users/{userId} {
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());
    }

    match /bookings/{bookingId} {
      allow create: if isAdmin()
        || (isSignedIn()
        && request.resource.data.userId == request.auth.uid)
        || (!isSignedIn()
          && request.resource.data.userId == null
          && request.resource.data.customerName is string
          && request.resource.data.customerEmail is string
          && request.resource.data.customerPhone is string);
      allow read, update: if isAdmin()
        || (isSignedIn() && (
          resource.data.userId == request.auth.uid
          || resource.data.customerEmail == request.auth.token.email
        ));
      allow delete: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['booked', 'updatedAt'])
          && request.resource.data.booked >= 0
          && request.resource.data.booked <= resource.data.capacity
          && (request.resource.data.booked == resource.data.booked + 1
            || request.resource.data.booked == resource.data.booked - 1)
        );
    }

    match /plans/{planId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /specials/{specialId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /mail/{mailId} {
      allow create: if isAdmin();
      allow read, update, delete: if false;
    }

    match /oneOnOneSlots/{slotId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.status == 'reserved';
      allow update: if isAdmin();
      allow delete: if isAdmin() || isSignedIn();
    }
  }
}